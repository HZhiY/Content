# Copy this file to .env and fill local values.
# .env is intentionally ignored by git.

# Python executable used by workflow agents when running scripts.
# Examples: python, py -3, C:\\Users\\you\\AppData\\Local\\Programs\\Python\\Python312\\python.exe
PYTHON_EXECUTABLE=python

# Shared workflow script paths, relative to project root.
IMAGE_GENERATOR_SCRIPT=scripts/generate_images_from_prompts.py
PARAGRAPH_COUNTER_SCRIPT=scripts/count_paragraph_chars.py

# Image generation API configuration.
# IMAGE_API_PROVIDER supports: openai-compatible, minimax
IMAGE_API_PROVIDER=openai-compatible
IMAGE_API_URL=https://example.com/v1/images/generations
IMAGE_API_KEY=replace-with-your-api-key
IMAGE_API_MODEL=gpt-image-2
IMAGE_DEFAULT_SIZE=1024x1024
IMAGE_REQUEST_TIMEOUT=180
